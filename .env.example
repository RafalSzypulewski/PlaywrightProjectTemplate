# Copy to .env (or .env.<TEST_ENV>) and adjust. Never commit real values or secrets.
# Precedence: real environment variables (CI secrets) > .env.<TEST_ENV> > .env
# Empty values are treated as not set. Schema: config/env.schema.ts

# Environment name; selects .env.<TEST_ENV>. One of: dev | staging | prod-smoke (default: dev)
TEST_ENV=dev

# Application under test (required)
BASE_URL=https://www.saucedemo.com

# API base URL (optional; defaults to BASE_URL)
# API_BASE_URL=https://api.example.com

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Worker count override (optional; defaults are set in playwright.config.ts)
# WORKERS=4

# Set by CI providers; enables retries and forbidOnly. Leave unset locally.
# CI=true

# Example credentials for projects that add authentication (add to config/env.schema.ts first):
# ADMIN_USERNAME=admin@example.com
# ADMIN_PASSWORD=change-me
